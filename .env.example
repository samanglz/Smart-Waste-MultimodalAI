# Local single-user backend identity. Never pass this through API requests.
SMART_WASTE_ACTOR_ID=local-user

# Optional: required for answer generation and Gemini-backed context analysis.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=

# Defaults used by the Docker deployment:
# SMART_WASTE_ONNX_MODEL=/app/exports/best.onnx
# SMART_WASTE_RAG_INDEX_DIR=/app/data/retrieval_index/v4_expanded
